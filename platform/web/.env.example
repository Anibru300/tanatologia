# Variables públicas de Supabase (seguras para usar en el frontend)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# NOTA: El service role key NUNCA debe ir en el frontend.
# Úsalo solo en scripts locales como scripts/seed-demo.mjs.

# NOTA: Resend se configura como secreto de Supabase Edge Functions,
# no en el frontend. Ve platform/supabase/supabase/functions/send-email/index.ts

# (Opcional) Dominio del servidor de videollamadas, sin protocolo.
# Por defecto es meet.jit.si (gratuito). Para migrar a JaaS (8x8.vc),
# cambia este valor y agrega el JWT según docs/investigacion-plataforma.
# En CI/CD se define como variable de GitHub Actions (vars.VITE_JITSI_DOMAIN).
VITE_JITSI_DOMAIN=meet.jit.si
